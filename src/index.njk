---
layout: base.njk
title: Journal
---

<section class="intro">
  <p class="eyebrow">WRITING · PHOTOGRAPHY · NOTES</p>
  <h1>SUP?</h1>
  <p>Ordinary Think</p>
</section>

<section class="grid">
{% for post in collections.posts | reverse %}
  <article class="card">
    <a href="{{ post.url }}">

      <div class="card-body">
        <p class="eyebrow">
          {{ post.data.category or "Journal" }}
        </p>

        <h2>{{ post.data.title }}</h2>

        <time>
          {{ post.date | readableDate }}
        </time>

        {% if post.data.excerpt %}
          <p class="excerpt">
            {{ post.data.excerpt }}
          </p>
        {% endif %}
      </div>

      {% if post.data.cover %}
        <img
          src="{{ post.data.cover }}"
          alt="{{ post.data.title }}"
          class="card-image"
        >
      {% endif %}

    </a>
  </article>
{% endfor %}
</section>
