---
layout: base.njk
title: Journal
---
<section class="intro">
  <p class="eyebrow">WRITING · PHOTOGRAPHY · NOTES</p>
  <h1>SUP?</h1>
  <p>Odinary Think</p>
</section>
<section class="grid">
{% for post in collections.posts | reverse %}
  <article class="card">
    <a href="{{ post.url }}">
      {% if post.data.cover %}<img src="{{ post.data.cover }}" alt="{{ post.data.title }}">{% endif %}
      <div class="card-body">
        <p class="eyebrow">{{ post.data.category or "Journal" }}</p>
        <h2>{{ post.data.title }}</h2>
        {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
        <time>{{ post.date | readableDate }}</time>
      </div>
    </a>
  </article>
{% endfor %}
</section>
